# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing and local browser artifacts
/coverage/
/.playwright-cli/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug*.log
firestore-debug*.log
ui-debug*.log

# environment (keep the configuration template)
.env*
!.env.example

# local dev sandbox data & service account keys
.patungin-dev-data.json
*firebase-adminsdk*.json
service-account*.json
/.firebase/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Keep the shared index checker required by the test suite; other local CLIs stay private.
/scripts/*
!/scripts/check-firestore-indexes.mjs

# Generated output is intentionally not published.
/output/

# Stray browser automation error output
/r.cssText)
