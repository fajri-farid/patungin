# ==============================================================================
# KONFIGURASI ENVIRONMENT — PATUNGIN
# ==============================================================================
# Salin file ini menjadi `.env.local` untuk pengembangan lokal atau isi pada
# variabel environment penyedia hosting Anda (mis. Vercel / Cloud Run / Railway).
#
# PENTING: Jangan pernah melakukan commit file `.env.local` atau kunci rahasia
# ke dalam repositori Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ORIGIN APLIKASI & DAFTAR EMAIL HOST YANG DIIZINKAN (WAJIB DI PRODUCTION)
# ------------------------------------------------------------------------------
# URL kanonis aplikasi (tanpa garis miring di akhir). Digunakan untuk proteksi
# CSRF (Origin check) dan pembentukan URL share link (/s/[token]).
APP_ORIGIN=http://localhost:3000

# Daftar alamat email akun Google yang diizinkan masuk sebagai Host.
# Pisahkan dengan koma jika lebih dari satu. Pencocokan bersifat exact match.
# Pengguna diaktifkan melalui undangan atau halaman admin.
# Akun yang sudah memiliki profil mengikuti status akses profil tersebut.
ALLOWED_EMAILS=

# Tetapkan admin secara eksplisit. Gunakan UID Google Firebase atau email terverifikasi.
# Tidak ada pemberian admin otomatis kepada pendaftar pertama.
ADMIN_UIDS=
ADMIN_EMAILS=emailkamu@gmail.com

# Rahasia acak server minimal 32 karakter untuk verifikator kode undangan.
# Buat dengan: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
INVITE_SIGNING_SECRET=

# ------------------------------------------------------------------------------
# 2. FIREBASE CLIENT SDK (HANYA UNTUK TOMBOL GOOGLE SIGN-IN DI BROWSER)
# ------------------------------------------------------------------------------
# Dapatkan dari Firebase Console -> Project Settings -> General -> Your Apps (Web).
# Catatan: Seluruh pembacaan/penulisan database tetap melewati server Next.js.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# ------------------------------------------------------------------------------
# 3. FIREBASE ADMIN SDK (RAHASIA SERVER — JANGAN DIEKSPOS KE NEXT_PUBLIC_*)
# ------------------------------------------------------------------------------
# Dapatkan dari Firebase Console -> Project Settings -> Service Accounts ->
# Generate New Private Key.
# Pastikan FIREBASE_PRIVATE_KEY diapit tanda kutip ganda bila memuat karakter \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI API & KENDALI BIAYA SCAN STRUK (RAHASIA SERVER)
# ------------------------------------------------------------------------------
# Kill switch fitur scan struk. Ubah ke `true` setelah GEMINI_API_KEY siap.
GEMINI_SCAN_ENABLED=false

# API Key dari Google AI Studio (https://aistudio.google.com/).
# Disarankan menggunakan project dengan tier berbayar bila memproses struk nyata.
GEMINI_API_KEY=

# Nama model Gemini yang mendukung input gambar & structured output JSON Schema.
GEMINI_MODEL=gemini-3.1-flash

# Batas aman pemakaian scan Gemini (mencegah lonjakan biaya):
SCAN_MONTHLY_LIMIT=30
SCAN_PER_MINUTE_LIMIT=3
# Zona aplikasi tetap WITA; nilai ini untuk dokumentasi setup.
USAGE_TIMEZONE=Asia/Makassar

# ------------------------------------------------------------------------------
# 5. KEAMANAN LINK HASIL BACA-SAJA (/s/[token])
# ------------------------------------------------------------------------------
# Isi SHARE_SIGNING_SECRET agar link berbagi dapat digunakan.
# `false` menolak pembuatan link baru dan akses ke semua link yang sudah dibuat.
SHARE_LINKS_ENABLED=true

# Rahasia acak minimal 32 karakter untuk menandatangani token HMAC-SHA-256.
# Buat dengan perintah: `openssl rand -base64 32`
SHARE_SIGNING_SECRET=

# ------------------------------------------------------------------------------
# 6. FOTO STRUK SEMENTARA — v1.1.0 (opsional, server-only)
# ------------------------------------------------------------------------------
# Aktifkan setelah bucket PRIVAT, billing Blaze, IAM dan scheduler cleanup siap.
# Masa akses tetap 24 jam. Cleanup wajib tetap berjalan ketika fitur dinonaktifkan.
RECEIPT_PHOTOS_ENABLED=false
RECEIPT_PHOTO_SHARING_ENABLED=false
FIREBASE_STORAGE_BUCKET=
# Secret acak minimal 32 karakter. Scheduler mengirim Authorization: Bearer SECRET
# Buat dengan perintah: `openssl rand -base64 32`. Gunakan untuk memverifikasi request
# ke POST /api/internal/receipt-cleanup setiap 15 menit.
RECEIPT_CLEANUP_SECRET=
# Vercel Cron harian (GET endpoint yang sama). Secret server acak minimal 32 karakter.
# Isi di environment Production Vercel; dikirim otomatis sebagai Authorization: Bearer.
CRON_SECRET=
RECEIPT_UPLOAD_HOURLY_LIMIT=10
RECEIPT_MAX_STORED_PER_USER=30
RECEIPT_PUBLIC_READS_PER_MINUTE=60
RECEIPT_DEPLOYMENT_READS_PER_MINUTE=600

# Gambar QRIS: memakai FIREBASE_STORAGE_BUCKET secara default, tanpa expiry struk.
# Lifecycle hapus 1 hari HARUS dibatasi prefix receipts/, bukan seluruh bucket.
QRIS_IMAGES_ENABLED=false
QRIS_MAX_STORED_PER_USER=30
# Opsional: bucket privat terpisah untuk QRIS; kosong = pakai bucket di atas.
FIREBASE_QRIS_STORAGE_BUCKET=
