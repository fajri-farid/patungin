rules_version = '2';

// Sesuai arsitektur keamanan Patungin (.agents/plan/04-architecture-data.md):
// Seluruh pembacaan dan penulisan koleksi produk dilakukan melalui Server Next.js
// menggunakan Firebase Admin SDK setelah melewati guard sesi, allowlist, dan ownership.
// Akses langsung dari browser ke Firestore ditolak seluruhnya (deny-by-default).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
